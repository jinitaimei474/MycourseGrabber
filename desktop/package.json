{
  "name": "sjtu-assistant-desktop",
  "productName": "SJTU Assistant",
  "version": "1.1.0",
  "private": true,
  "description": "Local SJTU course and Shuiyuan assistant for Windows",
  "author": "Local SJTU Assistant Project",
  "main": "src/main.cjs",
  "scripts": {
    "sync": "node scripts/sync.cjs",
    "start": "npm run sync && electron .",
    "test": "npm run sync && node --test test/*.test.cjs",
    "test:shuiyuan": "npm run sync && node test/shuiyuan-browser.cjs && node test/shuiyuan-ui.cjs",
    "test:browser": "node test/browser.cjs",
    "test:ui": "node test/ui.cjs",
    "test:package": "node test/package.cjs",
    "build": "npm run sync && node scripts/build.cjs"
  },
  "dependencies": { "playwright-core": "1.63.0" },
  "devDependencies": { "electron": "44.4.3", "@electron/packager": "20.3.0" }
}
